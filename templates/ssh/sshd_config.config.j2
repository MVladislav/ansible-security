# {{ ansible_managed }}
#
# OpenSSH server hardening configuration.
# Global configuration must remain before Match blocks.

############################
# Network
############################

Port {{ security_ssh_port | default(22) }}
AddressFamily {{ security_ssh_address_family | default('any') }}
{% if security_ssh_address_family | default('any') == 'inet' %}
ListenAddress 0.0.0.0
{% elif security_ssh_address_family | default('any') == 'inet6' %}
ListenAddress ::
{% endif %}

############################
# Host keys
############################

{% for key in security_ssh_host_keys | default([]) %}
HostKey {{ key }}
{% endfor %}

############################
# Cryptography
############################

{% if security_ssh_ciphers | default([]) | length > 0 %}
Ciphers {{ security_ssh_ciphers | join(',') }}
{% endif %}
{% if security_ssh_kex_algorithms | default([]) | length > 0 %}
KexAlgorithms {{ security_ssh_kex_algorithms | join(',') }}
{% endif %}
{% if security_ssh_macs | default([]) | length > 0 %}
MACs {{ security_ssh_macs | join(',') }}
{% endif %}
{% if security_ssh_host_key_algorithms | default([]) | length > 0 %}
HostKeyAlgorithms {{ security_ssh_host_key_algorithms | join(',') }}
{% endif %}
{% if security_ssh_pubkey_accepted_algorithms | default([]) | length > 0 %}
PubkeyAcceptedAlgorithms {{ security_ssh_pubkey_accepted_algorithms | join(',') }}
{% endif %}
{% if security_ssh_ca_signature_algorithms | default([]) | length > 0 %}
CASignatureAlgorithms {{ security_ssh_ca_signature_algorithms | join(',') }}
{% endif %}

RekeyLimit {{ security_ssh_rekey_limit | default('default none') }}
RequiredRSASize {{ security_ssh_required_rsa_size | default(3072) }}

############################
# Authentication
############################

LoginGraceTime {{ security_ssh_login_grace_time | default('30s') }}
PermitRootLogin {{ security_ssh_permit_root_login | default('no') }}
StrictModes {{ security_ssh_strict_modes | default(true) | ternary('yes', 'no') }}
MaxAuthTries {{ security_ssh_max_auth_tries | default(3) }}
MaxSessions {{ security_ssh_max_sessions | default(10) }}
MaxStartups {{ security_ssh_max_startups | default('10:30:60') }}

PubkeyAuthentication {{ security_ssh_pubkey_authentication | default(true) | ternary('yes', 'no') }}
# TODO: extend for 2FA - AuthenticationMethods publickey,keyboard-interactive:pam
AuthenticationMethods {{ security_ssh_authentication_methods | default('publickey') }}
AuthorizedKeysFile {{ security_ssh_authorized_keys_file | default('.ssh/authorized_keys') }}

PasswordAuthentication {{ security_ssh_password_authentication | default(false) | ternary('yes', 'no') }}
KbdInteractiveAuthentication {{ security_ssh_kbd_interactive_authentication | default(false) | ternary('yes', 'no') }}
PermitEmptyPasswords {{ security_ssh_permit_empty_password | default(false) | ternary('yes', 'no') }}
PermitUserEnvironment {{ security_ssh_permit_user_environment | default(false) | ternary('yes', 'no') }}
PermitUserRC {{ security_ssh_permit_user_rc | default(false) | ternary('yes', 'no') }}

############################
# PAM
############################

# PAM account and session processing remains enabled.
# Password and keyboard-interactive authentication are independently controlled above.
UsePAM {{ security_ssh_use_pam | default(true) | ternary('yes', 'no') }}

############################
# Host-based authentication
############################

HostbasedAuthentication no
IgnoreRhosts yes

############################
# Kerberos / GSSAPI
############################

GSSAPIAuthentication {{ security_ssh_gssapi_authentication | default(false) | ternary('yes', 'no') }}
GSSAPICleanupCredentials {{ security_ssh_gssapi_cleanup_credentials | default(true) | ternary('yes', 'no') }}

############################
# Forwarding and tunnelling
############################

DisableForwarding {{ security_ssh_disable_forwarding | default(true) | ternary('yes', 'no') }}

AllowAgentForwarding {{ security_ssh_allow_agent_forwarding | default(false) | ternary('yes', 'no') }}
AllowTcpForwarding {{ security_ssh_tcp_forwarding | default(false) | ternary('yes', 'no') }}
AllowStreamLocalForwarding {{ security_ssh_stream_local_forwarding | default(false) | ternary('yes', 'no') }}

GatewayPorts no
PermitTunnel no
X11Forwarding {{ security_ssh_x11_forwarding | default(false) | ternary('yes', 'no') }}

############################
# Session
############################

PermitTTY {{ security_ssh_permit_tty | default(true) | ternary('yes', 'no') }}
PrintMotd {{ security_ssh_print_motd | default(false) | ternary('yes', 'no') }}
PrintLastLog yes

TCPKeepAlive {{ security_ssh_tcp_keep_alive | default(true) | ternary('yes', 'no') }}
ClientAliveInterval {{ security_ssh_client_alive_interval | default(300) }}
ClientAliveCountMax {{ security_ssh_client_alive_count_max | default(2) }}

UseDNS {{ security_ssh_use_dns | default(false) | ternary('yes', 'no') }}
Compression no

############################
# Logging
############################

SyslogFacility {{ security_ssh_syslog_facility | default('AUTHPRIV') }}
LogLevel {{ security_ssh_log_level | default('VERBOSE') }}

############################
# Environment
############################

AcceptEnv {{ security_ssh_accept_env | default('LANG LC_*') }}

############################
# Banner
############################

{% if security_ssh_banner | default('') | length > 0 %}
Banner {{ security_ssh_banner }}
{% else %}
Banner none
{% endif %}

############################
# SFTP
############################

{% for subsystem in security_ssh_subsystems | default([{'name': 'sftp', 'command': 'internal-sftp -f AUTHPRIV -l INFO'}]) %}
Subsystem {{ subsystem.name }} {{ subsystem.command }}
{% endfor %}

############################
# User restrictions
############################

{% if security_ssh_allow_users | default([]) | length > 0 %}
AllowUsers {{ security_ssh_allow_users | join(' ') }}
{% endif %}

{% if security_ssh_allow_groups | default([]) | length > 0 %}
AllowGroups {{ security_ssh_allow_groups | join(' ') }}
{% endif %}

############################
# Per-user configuration
############################

{% for user in security_ssh_users | default([]) %}
Match User {{ user.name }}
{% if user.settings is defined %}
{% for key, value in user.settings.items() %}
    {{ key }} {{ value }}
{% endfor %}
{% endif %}
{% if user.authorized_keys is defined %}
    AuthorizedKeysFile /etc/ssh/authorized_keys/{{ user.name }}
{% endif %}

{% endfor %}

# Include drop-in configuration last so that the hardened settings above win
# over files in sshd_config.d (e.g. cloud-init's 50-cloud-init.conf).
Include /etc/ssh/sshd_config.d/*.conf
